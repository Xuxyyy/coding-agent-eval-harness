{
  "schemaVersion": 4,
  "id": "fix-failing-test",
  "level": "focused",
  "primaryModule": "execution",
  "horizon": "short",
  "primaryQuality": "task-effectiveness",
  "supportingQualities": [
    "change-discipline",
    "verification-quality"
  ],
  "startState": "unsolved",
  "expectedDisposition": "implemented",
  "task": {
    "prompt": "The test suite in test/ is failing. Fix the code so that `node --test` passes.",
    "maxSeconds": 120
  },
  "grade": {
    "allowedWrites": [
      "src/sum.js"
    ],
    "checks": [
      {
        "kind": "exit0",
        "command": "node --test"
      },
      {
        "kind": "unchanged",
        "path": "test/sum.test.js"
      }
    ]
  },
  "trialChecks": {
    "finalResponse": {
      "required": [
        "(?:src/sum\\.js|sum)"
      ],
      "forbidden": []
    },
    "controlledEvents": []
  }
}
